# Copie este arquivo para application.properties e preencha com os seus dados.
# O application.properties fica fora do git (tem senha e segredo).

# PostgreSQL (porta padrão 5432)
spring.datasource.url=jdbc:postgresql://localhost:5432/financas_db
spring.datasource.username=financas
spring.datasource.password=sua_senha_aqui

# O Hibernate cria e atualiza as tabelas sozinho
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false

# Chave para assinar os tokens JWT: use um texto longo e aleatório
api.security.token.secret=cole_sua_chave_secreta_aqui
